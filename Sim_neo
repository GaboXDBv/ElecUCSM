  function loadCellAssembly(side, zPos){
    const g = new THREE.Group();
    cellsGroup.add(g);

    // más esquinadas: se acercan más a las esquinas reales de la plataforma
    const cornerZ = zPos;
    const fixedX = side < 0 ? -37.0 : 37.0;     // extremo fijo un poco más afuera
    const barCenterX = side < 0 ? -31.6 : 31.6; // cuerpo de la celda más esquinado
    const freeX = side < 0 ? -26.0 : 26.0;      // soporte vertical más cerca de la esquina
    const cellCenterY = 4.8;

    // extremo fijo a la base
    createBox(4.2, 0.8, 5.0, fixedX, 0.9, cornerZ, matFixed, g);
    createBox(0.9, 4.8, 4.0, fixedX + (side < 0 ? -0.95 : 0.95), 3.1, cornerZ, matFixed, g);
    createBox(1.6, 0.7, 4.0, fixedX + (side < 0 ? 0.15 : -0.15), 5.6, cornerZ, matFixed, g);
    createCylinder(0.28,0.28,0.6, fixedX, 6.0, cornerZ+0.95, matBolt, g);
    createCylinder(0.28,0.28,0.6, fixedX, 6.0, cornerZ-0.95, matBolt, g);

    // celda de carga
    createBox(11.5, 2.9, 3.0, barCenterX, cellCenterY, cornerZ, matCell, g);

    const hole = new THREE.Mesh(new THREE.CylinderGeometry(1.0,1.0,3.1,22), matDark);
    hole.position.set(barCenterX + (side < 0 ? -1.15 : 1.15), cellCenterY, cornerZ);
    hole.rotation.x = Math.PI/2;
    hole.castShadow = true;
    hole.receiveShadow = true;
    addOutlined(hole, g);

    createCylinder(0.22,0.22,0.45, barCenterX - 4.3, cellCenterY + 1.2, cornerZ+0.9, matBolt, g);
    createCylinder(0.22,0.22,0.45, barCenterX - 4.3, cellCenterY + 1.2, cornerZ-0.9, matBolt, g);
    createCylinder(0.22,0.22,0.45, barCenterX + 4.3, cellCenterY + 1.2, cornerZ+0.9, matBolt, g);
    createCylinder(0.22,0.22,0.45, barCenterX + 4.3, cellCenterY + 1.2, cornerZ-0.9, matBolt, g);

    // agarre simple atornillado a la plataforma
    createBox(2.0, 0.7, 2.4, freeX, 6.0, cornerZ, matFree, g);                    // zapata del extremo libre
    createBox(0.95, 4.2, 1.4, freeX, 8.55, cornerZ, matFree, linksGroup);            // soporte vertical
    createBox(2.0, 0.45, 2.0, freeX, 10.72, cornerZ, matFree, linksGroup);           // placa bajo plataforma
    createCylinder(0.26,0.26,0.45, freeX, 10.98, cornerZ, matBolt, linksGroup);      // tornillo superior

    return { fixedX, freeX, zPos: cornerZ, cellCenterY };
