    const dimsY = exploded ? 5 : 0;

    frameGroup.position.y += (frameY - frameGroup.position.y) * 0.07;
    cellsGroup.position.y += (cellsY - cellsGroup.position.y) * 0.07;
    linksGroup.position.y += (linksY - linksGroup.position.y) * 0.07;
    platformGroup.position.y += (platformY - platformGroup.position.y) * 0.07;
    babyGroup.position.y += (babyY - babyGroup.position.y) * 0.07;
    padsGroup.position.y += (padsY - padsGroup.position.y) * 0.07;
    supportGroup.position.y += (supportY - supportGroup.position.y) * 0.07;
    thermalGroup.position.y += (thermalY - thermalGroup.position.y) * 0.07;
    lowerShellGroup.position.y += (shellY - lowerShellGroup.position.y) * 0.07;
    drawerGroup.position.z += (drawerZ - drawerGroup.position.z) * 0.08;
    acrylicGroup.position.y += (acrylicY - acrylicGroup.position.y) * 0.07;
    sensorsGroup.position.y += (sensorsY - sensorsGroup.position.y) * 0.07;
    labelsGroup.position.y += (labelsY - labelsGroup.position.y) * 0.07;
    dimsGroup.position.y += (dimsY - dimsGroup.position.y) * 0.07;

    // Al sacar el compartimento, se ocultan tapa y panel frontal para ver el ducto
    const hideIndices = new Set([0,1,2,3,4,5]);
    lowerShellGroup.children.forEach((child, idx) => {
      if (hideIndices.has(idx)) child.visible = !drawerOpen;
      else child.visible = true;
    });

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    const w = container.clientWidth;
    const h = container.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });
})();
</script>
</body>
</html>
